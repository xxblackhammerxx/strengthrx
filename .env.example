DATABASE_URI=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# reCAPTCHA Enterprise
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LcO4IUsAAAAAIYWfZLT1Yzd8NPM0mvNPDTdXr_E
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY_HERE

# Practice Better API (OAuth2 Client Credentials)
# Get these from Practice Better Settings > API
PRACTICE_BETTER_CLIENT_ID=your_api_key_here
PRACTICE_BETTER_CLIENT_SECRET=your_api_secret_here

# Email (Resend) — wired into Payload via @payloadcms/email-resend
RESEND_API_KEY=re_your_api_key_here
RESEND_DEFAULT_FROM_ADDRESS=info@gainzmarketing.com
RESEND_DEFAULT_FROM_NAME=StrengthRX

# Anthropic (used by /features/meal-planner)
ANTHROPIC_API_KEY=sk-ant-your_api_key_here
# Password protecting /features/meal-planner
MEAL_PLANNER_PASSWORD=change-me

# Meta Pixel / Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
STRENGTHRX_PIXEL_ID=
DATASET_QUALITY_API=
META_TEST_EVENT_CODE=
# Comma-separated domains sharing our first-party _fbc/_fbp cookies. Sets the
# subdomain index Meta's parameter builder embeds in those values.
META_COOKIE_DOMAINS=yourstrengthrx.com
# Optional. A URL returning the caller's IP as plain text, used to capture an
# IPv6 address from the browser. Leave blank unless you have a first-party
# endpoint — a third-party echo service would receive visitor IPs from the ad
# landing pages.
NEXT_PUBLIC_META_IP_LOOKUP_URL=

# GoHighLevel booking calendar
NEXT_PUBLIC_GHL_CALENDAR_ID=

# GoHighLevel (server only — never NEXT_PUBLIC)
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_NEW_LEAD_STAGE_ID=
GHL_CUSTOM_FIELD_SHAPE=key
